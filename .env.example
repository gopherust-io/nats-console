# Copy to .env and fill in secrets before `docker compose up`.
# Never commit a real .env.

PROJECT_NAME=nats-console
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-generate-a-strong-password
ENCRYPTION_KEY=change-me-to-a-long-random-secret-min-16
# RS256 session JWT keys (openssl genrsa 2048 / openssl rsa -pubout).
# PEMs may use literal \n escapes in a single line.
SESSION_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEogIBAAKCAQEArPOfxRK+UZyDp3d5J27+O+zS0+dDWWw3n0dpoIaWow191daP\nTiRrCcLuoGosUAWCAuQKmMakAVJtMaN8aU1ojlENyySu6X/PYUKsKViOAmrO+nnU\nHsAD5fhK5QMk+oRDmB3dCz2U1Jc2g7Pbi2F6AK0q4Tj6lkXl357yZRGdHatBb2dT\nOePazWQ11wOjKEFDagRDEstdMhOBucxAoGcQb9JcHgsz3gM0Hdr1yRMtPpRUPn8F\nOxOU2FVu6RJjlimcGb+CcvbRRszm5n8vmLJze96AfjKxMDZuTT+Uf8udDG6v5IU/\n2fteKuSK8WC0BLjNOo/y3WXNkP1MdXDxsXHpjQIDAQABAoIBAC4sqPY7h9ZQHBIk\n4pK1nmivVKZAcwm3y63ZqgiyhhsoKfViYEYzkOQ9R+pKDmSa49gTvASH3BeCQybi\nh/+xK/37A9y9gXlTpzFHVKGBRAC/NV1IE2rWRvQp8wzrZv7/OvCs4Gv01/xeFq7Y\n4P94WdM+aFlTFgvyw2mNjReQuUrHEoW+OxsBKKQR4qhWv0LQC6wZxFDf1DnXipup\n6e/UAZDgTS7MsniAhQoMqCHJhwvjGIOBQLqhcD7wLyMKk/5ZBlW6PpeVxEzS+ybD\nvM5o6XGuVBPOCdZD5LwKtcgTDsBlFF2gA396jO2WR9Wu0JU5eblDr1pjnlLvAdwo\nn9cFuN0CgYEA4VMreEsjRTGYXK9989cgL8EC63MVImnmY8tfMoBaTavnVavU4N3C\nLmu2P3mqF/c3HtQliXswBqn2P7bn/x6v76tmTW92B1vHTSn/r4y0DPt3rKZiah92\nWdROG+hGaWF3w/zwJwTcjDD4yGAMt6ROEezMSyBcfg4zn56JJvuTaSsCgYEAxH8v\n+humtQwkAScIkNFLAJu+OTJMaornmRt/KN/ktbOTvDxfIFhkSjRzxp4K+nuyh//D\n+sc+8WOUKZMHCxJnTTNzLC3TVscGeo+riAiEA3hBZ51vEu4yFdlEjIXGccFpPNVc\ndVKvAOkmkh/tfcI5jq7Kp4wRCj1BjPS3a+f8rCcCgYAgIRzktUodNro0FS4PlBBZ\n3trMugc8df9NIZW8fMLjqmx9MdhUDCsBNYiyOmX/rtekRLnphbBOcvPTGACyxyxt\nL3KR/h/FYtfjb+auoJCX/U+ORddorH3Sx0wv/In1wtkyECIqXi4Yq27+G3wUv5AG\nTE7BM6ccrme8Df4emebmKwKBgBS6GdR3EDmuwyl/9Y5ZFWFGDGW6IYdniZCD7wDf\nxR9Jhv7nG12tFT8ik0fTKfNMEwP3fbO5SrFpwJo2ERsg4Naq4644Uz+nFM7e0sgx\npcM77yI/4BSOHahiV7G+9rTPIwuwseUKSL1+2nu1dHa8gxfC5kuQIcgDuCNnOOXf\n/a4nAoGAT8uawehUeaDkDZ3YFwXBMDi9qG6cVw3zV3YHz6D94BeU45+gdKj0MZ7Q\nEfCzPfuwBmhtEl6af6O9syfwMYoKXWCibWqaspLYoVejTk5Zc9+iz9cKL9Ru01nY\nMaQpyh93+iFtewfrqeFbquI2avRPZO6fSgTunbVSXhzMXasMvHs=\n-----END RSA PRIVATE KEY-----"
SESSION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEArPOfxRK+UZyDp3d5J27+\nO+zS0+dDWWw3n0dpoIaWow191daPTiRrCcLuoGosUAWCAuQKmMakAVJtMaN8aU1o\njlENyySu6X/PYUKsKViOAmrO+nnUHsAD5fhK5QMk+oRDmB3dCz2U1Jc2g7Pbi2F6\nAK0q4Tj6lkXl357yZRGdHatBb2dTOePazWQ11wOjKEFDagRDEstdMhOBucxAoGcQ\nb9JcHgsz3gM0Hdr1yRMtPpRUPn8FOxOU2FVu6RJjlimcGb+CcvbRRszm5n8vmLJz\ne96AfjKxMDZuTT+Uf8udDG6v5IU/2fteKuSK8WC0BLjNOo/y3WXNkP1MdXDxsXHp\njQIDAQAB\n-----END PUBLIC KEY-----"
# Access JWT TTL (default 15m). Refresh cookie TTL (default 168h).
# Fingerprint = SHA-256(User-Agent|ClientIP); set TRUSTED_PROXIES behind reverse proxies.
SESSION_TTL=15m
REFRESH_TOKEN_TTL=168h

POSTGRES_USER=natsconsol
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=natsconsol
DATABASE_URL=postgres://natsconsol:change-me-postgres-password@postgres:5432/natsconsol?sslmode=disable
# DATABASE_URL=postgres://user:pass@db.example:5432/natsconsol?sslmode=verify-full
NATS_URL=nats://nats:4222
NATS_MONITORING_URL=http://nats:8222
# 5-node lab (make nats-cluster-up) — list all peers so dial/reconnect balances:
# NATS_URL=nats://host.docker.internal:4222,nats://host.docker.internal:4223,nats://host.docker.internal:4224,nats://host.docker.internal:4225,nats://host.docker.internal:4226
# NATS_MONITORING_URL=http://host.docker.internal:8222
# NATS_URL=tls://nats.example:4222
# NATS_MONITORING_URL=https://nats.example:8222
NATS_TOKEN=
# or NATS_CREDS_FILE=/run/secrets/nats.creds
# NATS_TLS_CA_FILE=/run/secrets/nats-ca.pem
# NATS_TLS_CERT_FILE=/run/secrets/nats-client.pem
# NATS_TLS_KEY_FILE=/run/secrets/nats-client-key.pem
# NATS_TLS_SERVER_NAME=nats.example
NATS_TLS_INSECURE_SKIP_VERIFY=false

HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
DEFAULT_CLUSTER_NAME=default
STATIC_DIR=/app/web

# Telemetry (github.com/gopherust-io/tel) — configured entirely from env
TEL_SERVICE_NAME=nats-consol
TEL_ENABLE=true
TEL_COLLECTOR_GRPC_ADDR=127.0.0.1:4317
TEL_TRACES_ENABLE=true
TEL_TRACES_SAMPLER=parentbased_statustraceidratio:0.1
MONITOR_ENABLE=false
LOG_LEVEL=info
LOG_ENCODE=console
# POD_NAME=  # optional; set via K8s Downward API

# Optional tuning
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# SLOW_CONSUMER_PENDING_THRESHOLD=1000
# SLOW_CONSUMER_LAG_THRESHOLD=1000
# SLOW_CONSUMER_ACK_PENDING_RATIO=0.9
# BEHAVIOR_FINGERPRINT_KV_BUCKET=nats_consol_fingerprints

# Go runtime profiling (admin-only, on-demand routes; off by default)
PPROF_ENABLED=false
PPROF_AUTH_ENABLED=true

# Alert email delivery. SMTP_HOST and SMTP_PORT are always required.
# Delivery runs only when SMTP_ENABLED=true (and METRICS_SNAPSHOT_ENABLED=true).
# Set Console Users email to a real address (not *@local).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_TIMEOUT=15s
SMTP_FROM=nats-consol@local.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLED=false
#
# --- Mailpit (local catcher): docker compose --profile mail up --build
# UI: http://localhost:8025
# SMTP_ENABLED=true
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_TLS=false
# SMTP_FROM=nats-consol@local.test
#
# --- Gmail (real inbox): create an App Password (Google Account → Security → 2FA → App passwords)
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com

# AI assistant (Gemini — NATS JetStream context only)
# AI_ENABLED=true
# AI_API_KEY=your-gemini-api-key
# AI_MODEL=gemini-2.5-flash
